{
  "name": "opencode-gui",
  "version": "0.1.0",
  "description": "GUI Electron pour opencode, inspirée de l'interface Claude Code",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
